<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BatteryPill.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BatteryPill settings">

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- A Windows 11 Settings-style card: title + description left, control right -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="CardText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,20,0,6" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE83F;" FontSize="16" />
                <TextBlock Text="BatteryPill settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4" Padding="28,0,28,28" MaxWidth="760">
                <TextBlock Text="Appearance" Style="{StaticResource Section}" Margin="2,4,0,6" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Theme" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Match Windows follows your light/dark setting live" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="180" VerticalAlignment="Center">
                            <ComboBoxItem Content="Dark" Tag="dark" />
                            <ComboBoxItem Content="Light" Tag="light" />
                            <ComboBoxItem Content="Match Windows" Tag="auto" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Accent color" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="The fill above 50%; lower levels use warning colors" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <StackPanel x:Name="Swatches" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show on the pill" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Click the pill to cycle through these" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ComboBox x:Name="ModeBox" Grid.Column="1" MinWidth="180" VerticalAlignment="Center">
                            <ComboBoxItem Content="Time left" Tag="time" />
                            <ComboBoxItem Content="Percent" Tag="percent" />
                            <ComboBoxItem Content="Both" Tag="both" />
                            <ComboBoxItem Content="Power (watts)" Tag="power" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Size" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <ComboBox x:Name="SizeBox" Grid.Column="1" MinWidth="180" VerticalAlignment="Center">
                            <ComboBoxItem Content="Compact" Tag="compact" />
                            <ComboBoxItem Content="Normal" Tag="normal" />
                            <ComboBoxItem Content="Expanded" Tag="expanded" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Width="180" Minimum="30" Maximum="100" StepFrequency="5" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="Behavior" Style="{StaticResource Section}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Refresh every" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="How often the battery is read" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ComboBox x:Name="RefreshBox" Grid.Column="1" MinWidth="180" VerticalAlignment="Center">
                            <ComboBoxItem Content="1 second" Tag="1000" />
                            <ComboBoxItem Content="3 seconds" Tag="3000" />
                            <ComboBoxItem Content="5 seconds" Tag="5000" />
                            <ComboBoxItem Content="10 seconds" Tag="10000" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lock position" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="The pill can't be dragged" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LockToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hide over fullscreen apps" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Games and videos keep the whole screen" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FullscreenToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Animations" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="AnimationsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Fun status lines" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="&quot;Plenty in the tank.&quot; in the details card" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FunToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="System" Style="{StaticResource Section}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="AutoStartText" Text="Open BatteryPill when you sign in" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Check for updates" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Once a day, from GitHub's public releases" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="UpdatesToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TextBlock Text="About" Style="{StaticResource Section}" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="BatteryPill" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CardText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="CheckNowButton" Content="Check now" />
                            <Button x:Name="GetUpdateButton" Content="Get update" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                    <HyperlinkButton Content="batterypill.com" NavigateUri="https://batterypill.com" />
                    <HyperlinkButton Content="Buy me a coffee" NavigateUri="https://buymeacoffee.com/nobackhand" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
