<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BatteryPill</RootNamespace>
    <AssemblyName>BatteryPill</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, one folder, nothing to install first: the website download
         must just run. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Version>2.0.0</Version>
    <ApplicationIcon>Assets\BatteryPill.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the Windows App SDK pieces the app uses: the 2.x meta-package also
         pulls in AI/ML/Search/Widgets, which would ship as dead weight. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Management is not trim-safe: trimmed, its type initializer
         throws and every WMI read fails (caught in CI by the measured run's
         WMI probe). Keep it whole. -->
    <TrimmerRootAssembly Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\BatteryPill.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BatteryPill.Core\BatteryPill.Core.csproj" />
  </ItemGroup>

</Project>
