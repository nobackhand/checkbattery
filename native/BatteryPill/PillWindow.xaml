<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BatteryPill.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BatteryPill">

    <!-- The window is the pill plus a transparent margin the drop shadow falls into -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="ShadowHost" />
            <Rectangle x:Name="PillShape" />
            <Grid x:Name="FillHost" />
            <Rectangle x:Name="PillStroke" StrokeThickness="1" />
            <StackPanel
                x:Name="TextStack"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="-1">
                <TextBlock
                    x:Name="PrimaryText"
                    FontFamily="Segoe UI Variable Display, Segoe UI"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    TextLineBounds="Tight" />
                <TextBlock
                    x:Name="SecondaryText"
                    FontFamily="Segoe UI Variable Text, Segoe UI"
                    HorizontalAlignment="Center"
                    TextLineBounds="Tight"
                    Opacity="0.78"
                    Margin="0,3,0,0"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
