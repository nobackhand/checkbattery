<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BatteryPill.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BatteryPill">

    <!-- The window is the pill plus a transparent margin the drop shadow falls into -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="Pill" Width="108" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="ShadowHost" />
            <Rectangle x:Name="PillShape" RadiusX="17" RadiusY="17" Fill="#F01C1E24" />
            <Grid x:Name="FillHost">
                <Rectangle x:Name="FillBar" HorizontalAlignment="Left" Width="108" Fill="#5230D158" />
            </Grid>
            <Rectangle RadiusX="17" RadiusY="17" Stroke="#22FFFFFF" StrokeThickness="1" />
            <TextBlock
                x:Name="Label"
                Text="3h 8m"
                FontFamily="Segoe UI Variable Display, Segoe UI"
                FontWeight="SemiBold"
                FontSize="13.5"
                Foreground="#F5F5F7"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
