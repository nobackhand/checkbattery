<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BatteryPill.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BatteryPill details">

    <Grid x:Name="Root" Padding="20,16,20,16">
        <StackPanel x:Name="CardContent" Spacing="2">
            <!-- No battery: a calm, centred card -->
            <StackPanel x:Name="NoBatteryPanel" Visibility="Collapsed" Spacing="6" Padding="0,10,0,10">
                <FontIcon Glyph="&#xE83E;" FontSize="30" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Running on AC power" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="No battery to monitor on this PC." FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="BatteryPanel" Spacing="2">
                <Grid>
                    <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" Opacity="0.7" CharacterSpacing="20" />
                    <TextBlock x:Name="ElapsedText" FontSize="11" Opacity="0.5" HorizontalAlignment="Right" />
                </Grid>
                <TextBlock
                    x:Name="HeroText"
                    FontFamily="Segoe UI Variable Display, Segoe UI"
                    FontSize="40"
                    FontWeight="SemiBold"
                    Margin="0,2,0,0" />
                <TextBlock x:Name="TimeText" FontSize="15" FontWeight="SemiBold" Margin="0,-2,0,0" />

                <StackPanel x:Name="PowerPanel" Spacing="6" Margin="0,12,0,0">
                    <TextBlock x:Name="PowerText" FontSize="13" Opacity="0.85" />
                    <Grid x:Name="MeterTrack" Height="6" CornerRadius="3">
                        <Border x:Name="MeterFill" HorizontalAlignment="Left" CornerRadius="3" />
                        <Rectangle x:Name="MeterAvgTick" Width="2" HorizontalAlignment="Left" Height="10" Margin="0,-2,0,-2" Opacity="0.55" />
                    </Grid>
                    <TextBlock x:Name="MeterCaption" FontSize="11" Opacity="0.55" />
                </StackPanel>

                <TextBlock x:Name="FunText" FontSize="12" FontStyle="Italic" Opacity="0.6" Margin="0,10,0,0" TextWrapping="Wrap" />

                <Grid x:Name="SparkArea" Height="56" Margin="0,14,0,0" CornerRadius="6">
                    <Canvas x:Name="SparkCanvas" />
                </Grid>
                <Grid Margin="0,4,0,0">
                    <TextBlock x:Name="SparkLeft" FontSize="11" Opacity="0.5" />
                    <TextBlock Text="now" FontSize="11" Opacity="0.5" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
